# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/opulence?retryWrites=true&w=majority

# JWT Secret (use a strong 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_change_this_in_production

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=securepassword123

# Allowed Origins (comma-separated for CORS)
# For local development: http://localhost:3000,http://localhost:5000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=*

# Node Environment
NODE_ENV=production

# Server Port (for local development)
PORT=3000

# Logging
LOG_LEVEL=info
LOG_FILES=false

# Optional: Monitoring
# SENTRY_DSN=your_sentry_dsn_here
